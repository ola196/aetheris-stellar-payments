SOROBAN_CONTRACT_ID=C...
SOROBAN_TOKEN_ID=C...
PAY_TO=G...
SOROBAN_SOURCE_ACCOUNT=G...
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REQUEST_PRICE=100
REPLAY_DATABASE=./data/replay.sqlite
PORT=4020

# Per-endpoint payment requirements (optional).
# When set, ENDPOINT_REQUIREMENTS takes full precedence over REQUEST_PRICE and
# SOROBAN_TOKEN_ID for route registration.  Set as a single-line JSON array:
#
# ENDPOINT_REQUIREMENTS=[{"path":"/paid/data","amount":"100","tokenAddress":"C...","description":"Metered data endpoint","mimeType":"application/json"}]
#
# Each object must have all five fields:
#   path          – Express route path, must start with "/"
#   amount        – positive integer string (smallest token units per call)
#   tokenAddress  – Stellar contract address of the accepted token (C...)
#   description   – human-readable label returned in the HTTP 402 body
#   mimeType      – MIME type returned in the HTTP 402 body
#
# Multiple endpoints with different prices and/or tokens:
# ENDPOINT_REQUIREMENTS=[{"path":"/paid/fast","amount":"500","tokenAddress":"C...","description":"Fast lane","mimeType":"application/json"},{"path":"/paid/slow","amount":"10","tokenAddress":"C...","description":"Slow lane","mimeType":"application/json"}]
